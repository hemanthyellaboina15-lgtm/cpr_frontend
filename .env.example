# ==============================================================================
# Campus Problem Reporting and Resolution System - Environment Variables
# Copy this file to .env or set environment variables in your system/IDE.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_problem_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security Configuration (Generate a secure 256-bit+ secret key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# Initial Super Administrator (Created on first startup if not already existing)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@campus.edu
ADMIN_DEFAULT_PASSWORD=Admin@123
